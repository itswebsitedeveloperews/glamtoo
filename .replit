modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "itswebsitedeveloper.ews@gmail.com"
SEO_SITE_ORIGIN = "https://glamtoo.webdesignessex.io"
ORDER_EMAIL_PUBLIC_URL = "https://glamtoo.webdesignessex.io"
ORDER_EMAIL_SEND_TO_ALL = "false"
ORDER_EMAIL_TRANSPORT = "gmail_smtp"
GMAIL_SMTP_AUTH_MODE = "oauth2"
EMAIL_BRANDING_TEST_APPROVAL_ID = "18d7984f-51b4-4267-acd6-4922da04cf24"
EMAIL_BRANDING_TEST_RECIPIENT = "itswebsitedeveloper.ews@gmail.com"

[userenv.production]
GMAIL_SMTP_OAUTH_REDIRECT_URI = "https://glamtoo.webdesignessex.io/api/gmail/oauth/callback"
ORDER_CONFIRMATION_ENABLED_SINCE = "2026-10-14T12:50:38.225Z"
ORDER_CONFIRMATION_SEND_TO_ALL = "true"

[userenv.development]
ORDER_CONFIRMATION_SEND_TO_ALL = "false"
ORDER_CONFIRMATION_TEST_RECIPIENTS = ""
