modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "itswebsitedeveloper.ews@gmail.com"
SEO_SITE_ORIGIN = "https://glamtoo.webdesignessex.io"
ORDER_EMAIL_PUBLIC_URL = "https://glamtoo.webdesignessex.io"
ORDER_EMAIL_SEND_TO_ALL = "false"
ORDER_EMAIL_TRANSPORT = "gmail_smtp"
GMAIL_SMTP_AUTH_MODE = "oauth2"

[userenv.production]
GMAIL_SMTP_OAUTH_REDIRECT_URI = "https://glamtoo.webdesignessex.io/api/gmail/oauth/callback"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 18781
externalPort = 3000
