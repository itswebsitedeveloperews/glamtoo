{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node ./test/isolated.mjs",
    "test:listing-preview": "esbuild test/listing-preview.test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.compiled/listing-preview.test.mjs && node --test test/.compiled/listing-preview.test.mjs",
    "test:preview-retention": "esbuild test/listing-preview-retention.test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.compiled/listing-preview-retention.test.mjs && node --test test/.compiled/listing-preview-retention.test.mjs",
    "previews:retain": "esbuild scripts/retain-listing-previews.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.compiled/retain-listing-previews.mjs && node scripts/.compiled/retain-listing-previews.mjs",
    "test:guest-checkout": "node ./test/isolated.mjs guest-checkout",
    "test:isolated": "node ./test/isolated.mjs",
    "test:gallery-repair": "node --test test/gallery-repair.test.mjs",
    "test:checkout-safety": "node ./test/isolated.mjs checkout-safety",
    "test:shipping": "node ./test/isolated.mjs shipping",
    "test:email-confirmations": "node ./test/isolated.mjs email-confirmations",
    "test:order-email-actions": "node ./test/isolated.mjs order-email-actions",
    "test:gmail-smtp": "node ./test/isolated.mjs gmail-smtp",
    "test:gmail-oauth": "node ./test/isolated.mjs gmail-oauth",
    "test:contact-notifications": "node ./test/isolated.mjs contact-notifications",
    "test:contact-email-template": "esbuild test/contact-email-template.test.ts --bundle --platform=node --format=cjs --loader:.png=base64 --outfile=../../generated-artifacts/contact-email-template.test.cjs && node --test ../../generated-artifacts/contact-email-template.test.cjs",
    "test:email-branding": "esbuild test/contact-email-template.test.ts test/order-confirmation-template.test.ts test/email-branding.test.ts --bundle --platform=node --format=cjs --loader:.png=base64 --out-extension:.js=.cjs --outdir=../../generated-artifacts/email-branding-tests && node --test ../../generated-artifacts/email-branding-tests/*.cjs",
    "test:order-email-status": "esbuild test/order-email-status.test.ts --bundle --platform=node --format=cjs --outfile=../../generated-artifacts/order-email-status.test.cjs && node --test ../../generated-artifacts/order-email-status.test.cjs",
    "verify:gmail-smtp": "node ./scripts/verify-gmail-smtp.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/shared": "^4.40.0",
    "@google-cloud/storage": "^7.22.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/shipping": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "http-proxy-middleware": "^4.2.0",
    "nodemailer": "^10.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
