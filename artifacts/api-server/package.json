{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node ./test/isolated.mjs",
    "test:guest-checkout": "node ./test/build.mjs guest-checkout",
    "test:isolated": "node ./test/isolated.mjs",
    "test:checkout-safety": "node ./test/isolated.mjs checkout-safety",
    "test:shipping": "node ./test/build.mjs shipping",
    "test:email-confirmations": "node ./test/build.mjs email-confirmations",
    "test:gmail-smtp": "node ./test/build.mjs gmail-smtp",
    "test:gmail-oauth": "node ./test/build.mjs gmail-oauth",
    "verify:gmail-smtp": "node ./scripts/verify-gmail-smtp.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@clerk/shared": "^4.29.3",
    "@google-cloud/storage": "^7.17.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/shipping": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^10.5.0",
    "http-proxy-middleware": "^4.2.0",
    "nodemailer": "^10.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
