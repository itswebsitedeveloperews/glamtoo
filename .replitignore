# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
/attached_assets/*.msg
/attached_assets/*.mbox
/attached_assets/order-email-receipts/
/attached_assets/image_1791981809216.png
/attached_assets/image_1791981892738.png

# Do not package raw merchant email receipt evidence.
/attached_assets/*.eml
/attached_assets/0_Glam_Too_Boutique_1791976369380.txt
/attached_assets/0_Screenshot_7_1791975860512.png
/attached_assets/0_Screenshot_8_1791976351382.png
/attached_assets/image_1791975199603.png
/attached_assets/image_1791976145970.png
/attached_assets/image_1791976224105.png
